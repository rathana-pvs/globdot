# =====================================================================
# Globdot Production Environment Variables Configuration Template
# Copy this file to .env on your VPS and update the values:
#   cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# PostgreSQL Docker Container Configuration
# ---------------------------------------------------------------------
POSTGRES_USER=globdot
# Generate a strong password: openssl rand -base64 24
POSTGRES_PASSWORD=globdot_pass_123
POSTGRES_DB=globdot
POSTGRES_PORT=5437

# ---------------------------------------------------------------------
# Application Database Connection URI
# Must match the credentials above. Port 5437 connects to Docker container.
# ---------------------------------------------------------------------
DATABASE_URI=postgresql://globdot:globdot_pass_123@127.0.0.1:5437/globdot

# ---------------------------------------------------------------------
# Payload CMS Secret Key
# Generate a secure 64-char hex secret: openssl rand -hex 32
# ---------------------------------------------------------------------
PAYLOAD_SECRET=globdot-dev-secret-replace-in-production

# ---------------------------------------------------------------------
# Site Metadata & Domain
# In production, set to your canonical domain (e.g. https://globdot.com)
# ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://globdot.com
NEXT_PUBLIC_SITE_NAME="Globdot"

# Content Mode:
# 'preview' keeps preview content out of search engines.
# Set to 'production' for live public publishing.
CONTENT_MODE=production

# ---------------------------------------------------------------------
# PM2 Process Manager Tuning (Optional)
# ---------------------------------------------------------------------
# Recommended: 1 on 1GB-2GB VPS instances. Set to 2 or 'max' on multi-core servers.
PM2_INSTANCES=1

# ---------------------------------------------------------------------
# Cloudinary (Optional Media Storage / CDN)
# If disabled (default), uploads are saved locally to public/media/
# ---------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ENABLE_CLOUDINARY=false

# ---------------------------------------------------------------------
# AI & Analytics Integrations (Optional)
# ---------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
GOOGLE_GENERATIVE_AI_API_KEY=
